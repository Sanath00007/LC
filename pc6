#include<stdio.h>
#include<mpi.h>

int main(int argc,char *argv[]){
    int rank,size,number;
    MPI_Init(&argc,&argv);
    MPI_Comm_rank(MPI_COMM_WORLD,&rank);
    MPI_Comm_size(MPI_COMM_WORLD,&size);

    int data;
    if(rank==0){
     printf("Enter data");
        scanf("%d",&data);
    }
    MPI_Bcast(&data,1,MPI_INT,0,MPI_COMM_WORLD);
    printf("Process %d recieved %d",rank,data);
    MPI_Finalize();
    return 0;
    
}
