#include <stdio.h>
#include <mpi.h>

int main(int argc, char *argv[]) {
    int rank, size;
    int data[8], rec, gat[8];

    MPI_Init(&argc, &argv);

    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
    MPI_Comm_size(MPI_COMM_WORLD, &size);

    if (size != 8) {
        if (rank == 0) {
            printf("Please run with 8 processes\n");
        }

        MPI_Finalize();
        return 0;
    }

    // Only rank 0 initializes the data
    if (rank == 0) {
        for (int i = 0; i < 8; i++) {
            data[i] = i + 1;
        }
    }

    // Distribute one value to each process
    MPI_Scatter(
        data, 1, MPI_INT,
        &rec, 1, MPI_INT,
        0, MPI_COMM_WORLD
    );

    // Process the received value
    rec *= 10;

    // Collect results at rank 0
    MPI_Gather(
        &rec, 1, MPI_INT,
        gat, 1, MPI_INT,
        0, MPI_COMM_WORLD
    );

    // Only rank 0 prints the gathered array
    if (rank == 0) {
        for (int i = 0; i < 8; i++) {
            printf("%d ", gat[i]);
        }
        printf("\n");
    }

    MPI_Finalize();

    return 0;
}
