#include <stdio.h> 
#include <omp.h> 
int fibonacci(int n){ 
int x,y; 
if(n<=1) 
return n; 
#pragma omp task shared(x) 
x=fibonacci(n-1); 
#pragma omp task shared(y) 
y=fibonacci(n-2); 
#pragma omp taskwait 
return x+y; 
} 
int main(){ 
int n,result; 
printf("Enter value of n (Fibonacci number to calculate): "); 
scanf("%d",&n); 
double start_time=omp_get_wtime(); 
#pragma omp parallel 
{ 
#pragma omp single 
result=fibonacci(n); 
} 
double end_time=omp_get_wtime(); 
printf("Fibonacci number is %d\n",result); 
printf("Time taken is %f seconds\n",end_time-start_time); 
return 0; 
}
