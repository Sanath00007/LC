#include <stdio.h> 
#include <stdlib.h> 
#include <omp.h> 
int is_prime(int num) 
{ 
if (num <= 1) 
return 0; 
for (int i = 2; i * i <= num; i++) 
{ 
if (num % i == 0) 
return 0; 
} 
return 1; 
} 
int main() 
{ 
int n; 
printf("Enter the value of n: "); 
scanf("%d", &n); 
double start, end; 
start = omp_get_wtime(); 
printf("Serial Prime Numbers: "); 
for (int i = 1; i <= n; i++) 
{ 
if (is_prime(i)) 
{ 
printf("%d ", i); 
} 
} 
printf("\n"); 
end = omp_get_wtime(); 
printf("Serial Execution Time %f seconds\n", end - start); 
start = omp_get_wtime(); 
printf("Parallel Prime Numbers: "); 
#pragma omp parallel for schedule(dynamic) 
for (int i = 1; i <= n; i++) 
{ 
if (is_prime(i)) 
{ 
#pragma omp critical 
{ 
printf("%d ", i); 
} 
} 
} 
printf("\n"); 
end = omp_get_wtime(); 
printf("Parallel Execution Time %f seconds\n", end - start); 
return 0; 
} 
